#
# Copy this file to .env for project-local configuration.
# The .env file is ignored by git and only affects this repository.
#
# ============================================================
#  LLM API 配置
# ============================================================
# 支持 OpenAI 及所有兼容 OpenAI 接口的服务商：
#
#   ── 官方直连 ──
#   - OpenAI 官方:       只填 API_KEY，BASE_URL 留空
#   - DeepSeek 官方:     BASE_URL=https://api.deepseek.com/v1
#   - 通义千问 官方:     BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 智谱 GLM 官方:     BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   - Moonshot 官方:     BASE_URL=https://api.moonshot.cn/v1
#
#   ── 中转站（代理） ──
#   中转站统一使用 OpenAI 兼容格式，不论背后是 Claude、GPT 还是国产模型，
#   只需填写中转站给你的 BASE_URL 和 API_KEY，MODEL 填中转站支持的模型名。
#   常见中转站：api2d, closeai, oaifree, openrouter, one-api, new-api 等
#
#   - OpenRouter:        BASE_URL=https://openrouter.ai/api/v1
#   - 自建 one-api:      BASE_URL=https://你的域名/v1
#   - 其他中转站:         BASE_URL=https://中转站域名/v1
#
# ── 配置示例 ──
#
# 示例 1：OpenAI 官方
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=
#   OPENAI_MODEL=gpt-4o
#
# 示例 2：Claude 中转站
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://your-proxy.com/v1
#   OPENAI_MODEL=claude-sonnet-4-20250514
#
# 示例 3：DeepSeek 中转站
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://your-proxy.com/v1
#   OPENAI_MODEL=deepseek-chat
#
# 示例 4：通义千问 中转站
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://your-proxy.com/v1
#   OPENAI_MODEL=qwen-plus
#
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# 主模型协议层。MODEL_* 优先；留空时兼容复用上面的 OPENAI_*。
# MODEL_API_PROTOCOL 可选：chat_completions / responses / anthropic_messages
# Responses 要求服务端实现 /v1/responses；Anthropic Messages 要求实现 /v1/messages，
# 不能仅因模型名是 Claude 就选择 anthropic_messages。
# MODEL_API_PROTOCOL=chat_completions
# MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=
# MODEL_MAX_OUTPUT_TOKENS=8192

# Provider 前缀缓存，不是“相同问题复用整段回答”。Agent 工具调用可能有副作用，
# 因此项目不会缓存或重放主对话 response；这里只控制 provider prompt caching 并记录命中 token。
# OpenAI: 5m/1h 映射为 in-memory，24h 映射为 24h；Anthropic: 5m 或 1h。
# MODEL_PROMPT_CACHE_ENABLED=true
# MODEL_PROMPT_CACHE_KEY=cst-agent
# MODEL_PROMPT_CACHE_TTL=5m

# Agent Harness：默认使用现有 Python tool loop；显式改为 pi 才启用开源
# pi-agent-core sidecar。PI_* 留空时复用 OPENAI_*，Node 依赖安装在本仓库 D 盘。
AGENT_BRAIN=native
# Runtime-owned CST projects, bridge scripts and exports stay on D: by default.
# CST_RUNTIME_ROOT=D:\cst_agent_rag_data\runtime\cst_agent_workbench
# CST_FAST_PATH_DIR=D:\cst_agent_rag_data\runtime\cst_agent_workbench\projects\fast_path
# CST_TEMP_DIR=D:\cst_agent_rag_data\runtime\cst_agent_workbench\tmp\bridge
# PI_NODE_EXECUTABLE=node
# PI_SIDECAR_PATH=D:\path\to\cst-agent-workbench-remote\integrations\pi_agent_core\sidecar.mjs
# PI_SIDECAR_TIMEOUT_SEC=180
# PI_API_KEY=
# PI_BASE_URL=
# PI_MODEL=
# PI_API_PROTOCOL=chat_completions
# PI_CONTEXT_WINDOW=128000
# PI_MAX_OUTPUT_TOKENS=8192
# PI_THINKING_LEVEL=off
# PI_PROMPT_CACHE_ENABLED=true
# PI_PROMPT_CACHE_TTL=5m

# Agent 会话快照与跨会话结构化记忆。C 盘空间有限时请显式放到 D 盘。
# AGENT_MEMORY_DIR=D:\cst_agent_rag_data\agent_memory
# AGENT_CONTEXT_MAX_TOKENS=8192
# AGENT_HISTORY_RETENTION=200
# AGENT_TOOL_EVENT_RETENTION=500
# AGENT_TOOL_RESULT_RETENTION=100
# AGENT_MAX_REPLAN_RETRIES=1

# ============================================================
#  CST 官方文档 RAG 配置（可选）
# ============================================================
# 指定 PDF 文件夹路径，启动后可在 UI 中导入
# 留空则不预填 UI 路径，用户可在界面手动输入
#
# PDF_KNOWLEDGE_DIR=D:\docs\antenna_papers
# RAG_CACHE_DIR=D:\cst_agent_rag_data
# CHROMA_PERSIST_DIR=D:\cst_agent_rag_data\chromadb_v4
# CHROMA_COLLECTION_NAME=cst_official_docs_v4
# HF_HOME=D:\cst_agent_rag_data\hf_cache
# SENTENCE_TRANSFORMERS_HOME=D:\cst_agent_rag_data\hf_cache\hub
# HF_HUB_DISABLE_XET=1  # Xet 下载卡住时改走普通 HTTP
# Windows 下建议 persist/cache 路径只含 ASCII 字符；native HNSW 在含中文路径下
# 可能只写 SQLite/pickle 而漏写二进制索引文件，导致重启后 Error loading hnsw index。

# ============================================================
#  Embedding 配置
# ============================================================
# "local"（默认）: 用本地模型，免费离线；模型和 HF cache 请放在 D 盘
# "api": 用远程 embedding API（可以和 chat API 用不同的 key）
#
EMBEDDING_PROVIDER=local
# 英文 CST Online Help 基线：英文 passage + 英文检索 query
# EMBEDDING_LOCAL_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
# RAG_DOCUMENT_LANGUAGE=en
# RAG_DOCUMENT_QUERY_TRANSLATION=true
# RAG_RERANK_ENABLED=true
# RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RAG_RERANK_CANDIDATE_K=20
# RAG_RERANK_BATCH_SIZE=16
# RAG_RERANK_CACHE_DIR=D:\cst_agent_rag_data\reranker_models
#
# 如果 EMBEDDING_PROVIDER=api，配置以下项（留空则复用 OPENAI_* 的值）：
# EMBEDDING_API_KEY=replace_with_embedding_api_key
# EMBEDDING_BASE_URL=https://api.example.com/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
#  CST 连接（通常不需要改）
# ============================================================
# CST_CONNECT_TIMEOUT_SEC=90
# CST_CONNECT_RETRIES=1

# ============================================================
#  优化设置（通常不需要改）
# ============================================================
# OPT_TARGET_MODE=at_f0
# OPT_TARGET_S11_DB=-10.0
# OPT_MAX_ROUNDS=20
# OPT_STAGNATION_LIMIT=3
