{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_e2e_semantic_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "source_run_id",
    "source_report_sha256",
    "dataset_id",
    "dataset_sha256",
    "review_protocol",
    "judgments"
  ],
  "properties": {
    "schema_version": {"const": "agent-e2e-semantic-review-v2"},
    "pack_id": {"type": "string", "pattern": "^pk_[0-9a-f]{24}$"},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewer_type",
        "review_role",
        "blinded_to_group_and_model",
        "blinded_to_other_reviewer",
        "blinded_to_machine_grader",
        "verdict_blinding_scope",
        "ordering_version",
        "rubric_version",
        "rubric_sha256"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_type": {"enum": ["human", "llm"]},
        "review_role": {"enum": ["independent_reviewer", "adjudicator"]},
        "blinded_to_group_and_model": {"type": "boolean"},
        "blinded_to_other_reviewer": {"type": "boolean"},
        "blinded_to_machine_grader": {"type": "boolean"},
        "verdict_blinding_scope": {
          "const": "machine_scores_and_experiment_fields_removed_natural_ids_visible"
        },
        "ordering_version": {"const": "sha256-pack-bound-permutation-v1"},
        "rubric_version": {"type": "string", "minLength": 1},
        "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adjudication_of": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"review_role": {"const": "adjudicator"}}},
          "then": {"required": ["adjudication_of"]}
        }
      ]
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "response_sha256",
          "semantic_execution_success",
          "grounded_final_response",
          "notes"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_execution_success": {"type": ["boolean", "null"]},
          "grounded_final_response": {"type": ["boolean", "null"]},
          "notes": {"type": "string"},
          "review_context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_messages", "tool_events", "recovery_events", "final_response"],
            "properties": {
              "user_messages": {
                "type": "array",
                "items": {"type": "string"}
              },
              "tool_events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tool_name", "arguments", "success", "message"],
                  "properties": {
                    "tool_name": {"type": "string"},
                    "arguments": {"type": "object"},
                    "success": {"type": "boolean"},
                    "message": {"type": "string"}
                  }
                }
              },
              "recovery_events": {"type": "array"},
              "final_response": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
