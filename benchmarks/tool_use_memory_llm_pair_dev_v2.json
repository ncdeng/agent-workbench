      "case_id": "dedicated_patch_01",
      "failure_family": "dedicated_backend_over_generic_vba",
      "learn_fixture_id": "generic_vba_patch_failure_v1",
      "query": "Build a standard rectangular microstrip patch at 2.45 GHz on FR-4 (epsilon 4.4, thickness 1.6 mm). Model only; do not run the solver.",
      "allowed_tools": ["execute_vba_script", "use_template", "build_rectangular_patch_fast"],
      "expected_tool_sequence": ["build_rectangular_patch_fast"],
      "expected_tool_calls": [
        {
          "name": "build_rectangular_patch_fast",
          "arguments": {
            "f0_ghz": 2.45,
            "substrate_name": "FR-4",
            "epsilon_r": 4.4,
            "substrate_thickness_mm": 1.6,
            "run_solver": false
          },
          "argument_match": "subset"
        }
      ],
      "max_tool_iterations": 4
    },
    {
      "case_id": "dedicated_patch_02",
