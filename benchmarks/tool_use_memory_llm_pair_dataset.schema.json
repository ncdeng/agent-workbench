{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_use_memory_llm_pair_dataset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "split",
    "role",
    "blinded",
    "authoring_provenance",
    "learn_fixtures",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "tool-use-memory-pair-dataset-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["development_regression", "frozen_evaluation", "held_out"]},
    "role": {"type": "string", "minLength": 1},
    "blinded": {"type": "boolean"},
    "description": {"type": "string"},
    "authoring_provenance": {"type": "object"},
    "learn_fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "failure_family", "tool_name", "arguments"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "failure_family": {"type": "string", "minLength": 1},
          "tool_name": {"type": "string", "minLength": 1},
          "arguments": {"type": "object"},
          "setup_tools": {
            "type": "array",
            "items": {"$ref": "#/$defs/toolCall"}
          },
          "fake_injection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "response"],
            "properties": {
              "method": {"type": "string", "minLength": 1},
              "response": {"type": "object"}
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "failure_family",
          "learn_fixture_id",
          "query",
          "allowed_tools",
          "expected_tool_sequence"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "failure_family": {"type": "string", "minLength": 1},
          "learn_fixture_id": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "allowed_tools": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_tool_sequence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_tool_calls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "arguments"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "arguments": {"type": "object"},
                "argument_match": {"enum": ["subset", "exact"]}
              }
            }
          },
          "max_tool_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "setup_tools": {
            "type": "array",
            "items": {"$ref": "#/$defs/toolCall"}
          }
        }
      }
    }
  },
  "$defs": {
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"}
      }
    }
  }
}
